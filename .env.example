# Public Supabase settings (safe for the browser). Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where magic links should land. Must be an allowed Redirect URL in Supabase
# (Authentication > URL Configuration). Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Used by `npm run bootstrap` and by the app to write scan results
# (those tables have no user write policies). NEVER commit this or prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Providers (see README)
PROVIDER=mock
# QUERYING_API_KEY=
# Parallel queries per scan. Match your querying.ai plan's concurrent-task limit
# (Free 2, Basic 50, Pro 200). Default 2 when PROVIDER=queryingai.
# QUERYING_CONCURRENCY=2
